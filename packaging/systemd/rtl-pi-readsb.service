[Unit]
Description=RTL Pi ADS-B Decoder using readsb and dedicated RTL-SDR receiver
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
RuntimeDirectory=rtl-pi-readsb
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/readsb --device-type=rtlsdr --device=00001090 --gain=auto --quiet --net --write-json /run/rtl-pi-readsb --write-json-every 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
