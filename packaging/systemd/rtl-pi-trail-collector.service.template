[Unit]
Description=RTL Pi ADS-B Aircraft Trail Collector
After=network.target rtl-pi-readsb.service
Requires=rtl-pi-readsb.service

[Service]
Type=simple
User=pi
Group=pi
EnvironmentFile=@DEPLOY_DIR@/config/trail_collector.env
ExecStart=/usr/bin/python3 @DEPLOY_DIR@/bin/rtl_trail_collector.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
