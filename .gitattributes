# Text files
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.service text eol=lf

# Linux/macOS shell scripts must use LF, not CRLF.
*.sh text eol=lf
tools/*.sh text eol=lf
scripts/*.sh text eol=lf

# Binary files
vendor/readsb/linux-aarch64/readsb -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.gz -text
*.zip -text
